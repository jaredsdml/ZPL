<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#DDE1E6" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1B1F24" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5B6472" />
    <SolidColorBrush x:Key="AccentBrush" Color="#1F6AA5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#15517F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E8E3E" />
    <SolidColorBrush x:Key="RowInvalidBrush" Color="#FBE4E2" />
    <SolidColorBrush x:Key="RowValidBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#EEF0F3" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#E3E6EA" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#C7CCD3" />

</ResourceDictionary>
