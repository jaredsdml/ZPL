<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1B1D21" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#25282E" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#3A3F47" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EDEEF0" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A2A9B3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C9EE0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6FB3EA" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5675F" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CC073" />
    <SolidColorBrush x:Key="RowInvalidBrush" Color="#4A2A28" />
    <SolidColorBrush x:Key="RowValidBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GridHeaderBackgroundBrush" Color="#2E323A" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#3A3F47" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#2E323A" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#4A505A" />

</ResourceDictionary>
