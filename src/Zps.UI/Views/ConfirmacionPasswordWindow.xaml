<Window x:Class="Zps.UI.Views.ConfirmacionPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar eliminación"
        Height="240" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="TxtMensaje"
                   Text="⚠️ Esta acción eliminará permanentemente los registros seleccionados de Neon y de la caché local. No se puede deshacer."
                   TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBlock Text="Contraseña de confirmación:" Style="{StaticResource SubtleTextBlock}" Margin="0,0,0,4" />
        <PasswordBox x:Name="CajaPassword" Padding="6,5" KeyDown="CajaPassword_OnKeyDown" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" Click="BtnCancelar_OnClick" Margin="0,0,8,0" IsCancel="True" />
            <Button x:Name="BtnConfirmar" Content="Confirmar eliminación" Style="{StaticResource DangerButton}" Click="BtnConfirmar_OnClick" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
