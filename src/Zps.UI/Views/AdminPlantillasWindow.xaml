<Window x:Class="Zps.UI.Views.AdminPlantillasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Zps.UI.ViewModels"
        d:DataContext="{d:DesignInstance vm:AdminPlantillasViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Administración de Plantillas ZPL"
        Height="640" Width="960"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Panel lateral: listado de plantillas registradas -->
        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="PLANTILLAS REGISTRADAS" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Plantillas}"
                         SelectedItem="{Binding PlantillaSeleccionada}"
                         DisplayMemberPath="HojaExcel" />

                <Button Grid.Row="2" Style="{StaticResource SecondaryButton}"
                        Content="♻️ Restaurar / Importar Plantillas Base"
                        ToolTip="Reimporta las plantillas ZPL originales (MYC, AXO, MNS/MINISO, PRM, CEVA, DRL, etc.) desde cat_clientes. Si ya existen, se sobrescriben por nombre de hoja."
                        Command="{Binding RestaurarPlantillasBaseCommand}"
                        Margin="0,10,0,0" HorizontalContentAlignment="Center" />
            </Grid>
        </Border>

        <!-- Formulario de edición -->
        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="Nombre de Pestaña Excel (clave de enlace automático)" Style="{StaticResource SubtleTextBlock}" />
                    <TextBox Text="{Binding HojaExcel, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="Nombre de Cliente / Descripción" Style="{StaticResource SubtleTextBlock}" />
                    <TextBox Text="{Binding NombreCliente, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" />
                </StackPanel>

                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Activa (si se desmarca, el Generador ignora esta plantilla y usa el fallback existente)"
                          IsChecked="{Binding Activo}" Margin="0,0,0,12" />

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Código ZPL" Style="{StaticResource SubtleTextBlock}" Margin="0,0,0,4" />

                <TextBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                         Text="{Binding CodigoZpl, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Consolas" FontSize="13"
                         AcceptsReturn="True" AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Margin="0,0,0,12" />

                <!-- Panel informativo: tags permitidos -->
                <Border Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                        Background="{DynamicResource GridHeaderBackgroundBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                        Padding="10" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Tags disponibles (se reemplazan por el valor de la fila o del folio):" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock TextWrapping="Wrap" FontFamily="Consolas"
                                   Text="{}{{LPN}}  {{CONSECUTIVO}}  {{SKU}}  {{LOTE}}  {{CANTIDAD}}  {{CAJAS}}  {{TARIMA_ACTUAL}}  {{TARIMA_TOTAL}}  {{ARRIBO}}  {{SOLICITANTE}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Botonera + estado -->
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding EstadoMensaje}" TextWrapping="Wrap" VerticalAlignment="Center" />

            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="🆕 Nueva Plantilla" Command="{Binding NuevaPlantillaCommand}" />
            <Button Grid.Column="3" Style="{StaticResource DangerButton}" Content="🗑️ Eliminar" Command="{Binding EliminarCommand}" />
            <Button Grid.Column="5" Content="💾 Guardar" Command="{Binding GuardarCommand}" />
        </Grid>
    </Grid>
</Window>
